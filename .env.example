# Copiez ce fichier en .env (local) ou .env.production (serveur) et remplissez les valeurs.
# Ne jamais commiter un fichier contenant de vraies clés secrètes.

# --- Supabase (Réglages du projet > API) ---
SUPABASE_PROJECT_ID="ztddotfrmpvgwqlkculj"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_URL="https://ztddotfrmpvgwqlkculj.supabase.co"
VITE_SUPABASE_PROJECT_ID="ztddotfrmpvgwqlkculj"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_URL="https://ztddotfrmpvgwqlkculj.supabase.co"

# Clé secrète serveur (Réglages > API > service_role) — ne JAMAIS exposer côté client.
# Nécessaire pour l'espace admin, l'upload de pièces jointes et les fonctions serveur privilégiées.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- CRM : Brevo (transactionnel + liste prospects) ---
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""
BREVO_LIST_ID=""

# --- CRM : HubSpot (optionnel — laisser vide pour désactiver) ---
# Réglages HubSpot > Comptes connectés > Clés API privées (jeton "pat-na1-...")
HUBSPOT_API_KEY=""

# --- Runtime serveur (VPS) ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
